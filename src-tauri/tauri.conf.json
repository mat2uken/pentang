{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Common Core PoC",
  "version": "0.1.0",
  "identifier": "dev.example.commoncorepoc",
  "build": {
    "beforeDevCommand": "npm run dev:native-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:native-ui",
    "frontendDist": "../dist/native"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Common Core PoC",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' pocbin: http://pocbin.localhost ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": ["main-poc", "wdio-desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
